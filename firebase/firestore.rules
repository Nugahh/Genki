rules_version = '2';

// Closed by default: only the owner reaches users/{uid}/**, and a collection
// accepts writes only once its milestone validates them here (spec §8).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDayKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isShortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isFoodRef(ref) {
      return ref is map
        && ref.keys().hasOnly(['type', 'id'])
        && ref.type in ['ciqual', 'custom']
        && isShortText(ref.id, 64);
    }

    // Per-entry macros: grams are capped at 5 000, so no entry goes past 50 000 kcal.
    function isEntryMacros(m) {
      return m is map
        && m.keys().hasOnly(['kcal', 'protein', 'carbs', 'fat'])
        && m.kcal is number && m.kcal >= 0 && m.kcal <= 50000
        && m.protein is number && m.protein >= 0 && m.protein <= 5000
        && m.carbs is number && m.carbs >= 0 && m.carbs <= 5000
        && m.fat is number && m.fat >= 0 && m.fat <= 5000;
    }

    // Nutrients of an entry's portion: any of the 26 of the catalogue (nutrition/domain/nutrients.ts), each a number from 0 to 1 000 000.
    // An absent key reads as 0, so a missing nutrient passes. One `get` per nutrient keeps a full entry (26 of them) under the 1 000 expressions a request may evaluate.
    function nutrientOk(n, k) {
      let v = n.get(k, 0);
      return v is number && v >= 0 && v <= 1000000;
    }
    function isEntryNutrients(n) {
      return n is map
        && n.keys().hasOnly(['vitA', 'vitD', 'vitE', 'vitK', 'vitC', 'vitB1', 'vitB2', 'vitB3', 'vitB5', 'vitB6', 'vitB9', 'vitB12', 'calcium', 'iron', 'magnesium', 'potassium', 'zinc', 'selenium', 'iodine', 'phosphorus', 'copper', 'manganese', 'fiber', 'salt', 'saturatedFat', 'sugars'])
        && nutrientOk(n, 'vitA')
        && nutrientOk(n, 'vitD')
        && nutrientOk(n, 'vitE')
        && nutrientOk(n, 'vitK')
        && nutrientOk(n, 'vitC')
        && nutrientOk(n, 'vitB1')
        && nutrientOk(n, 'vitB2')
        && nutrientOk(n, 'vitB3')
        && nutrientOk(n, 'vitB5')
        && nutrientOk(n, 'vitB6')
        && nutrientOk(n, 'vitB9')
        && nutrientOk(n, 'vitB12')
        && nutrientOk(n, 'calcium')
        && nutrientOk(n, 'iron')
        && nutrientOk(n, 'magnesium')
        && nutrientOk(n, 'potassium')
        && nutrientOk(n, 'zinc')
        && nutrientOk(n, 'selenium')
        && nutrientOk(n, 'iodine')
        && nutrientOk(n, 'phosphorus')
        && nutrientOk(n, 'copper')
        && nutrientOk(n, 'manganese')
        && nutrientOk(n, 'fiber')
        && nutrientOk(n, 'salt')
        && nutrientOk(n, 'saturatedFat')
        && nutrientOk(n, 'sugars');
    }

    function isGrams(value) {
      return value is number && value > 0 && value <= 5000;
    }

    function isPer100g(m) {
      return m is map
        && m.keys().hasOnly(['kcal', 'protein', 'carbs', 'fat'])
        && m.kcal is number && m.kcal >= 0 && m.kcal <= 900
        && m.protein is number && m.protein >= 0 && m.protein <= 100
        && m.carbs is number && m.carbs >= 0 && m.carbs <= 100
        && m.fat is number && m.fat >= 0 && m.fat <= 100;
    }

    // What a product of Open Food Facts adds to a food of one's own (all optional).
    function isFoodExtras(d) {
      return (!('source' in d) || d.source == 'off')
        && (!('brand' in d) || isShortText(d.brand, 100))
        && (!('barcode' in d) || (d.barcode is string && d.barcode.matches('^[0-9]{8,14}$')))
        && (!('nutrients' in d) || isEntryNutrients(d.nutrients));
    }

    function isFoodFields(d) {
      return isShortText(d.name, 100)
        && d.state in ['raw', 'cooked', 'other']
        && isPer100g(d.per100g)
        && d.portions is list
        && d.portions.size() <= 20
        && d.updatedAt is timestamp;
    }

    // A day total field is optional; macro totals tolerate a tiny negative drift (sums of 0.1-rounded floats).
    function atLeast(data, field, min) {
      return !(field in data) || (data[field] is number && data[field] >= min);
    }

    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
    }

    // How the Suivi screens are set up (spec §4): the statistics of the hub, in order, and the period.
    function isUiPrefs(ui) {
      return ui is map
        && ui.keys().hasOnly(['hubMetrics', 'period'])
        && (!('hubMetrics' in ui) || (ui.hubMetrics is list && ui.hubMetrics.size() <= 30))
        && (!('period' in ui) || ui.period in ['day', 'week', 'month', 'year']);
    }

    function isContainer(c) {
      return c is map
        && c.keys().hasOnly(['label', 'ml'])
        && isShortText(c.label, 30)
        && c.ml is number && c.ml >= 1 && c.ml <= 5000;
    }

    // The list is read item by item up to its cap of 6: rules cannot loop.
    function isContainers(list) {
      return list is list
        && list.size() >= 1 && list.size() <= 6
        && (list.size() < 1 || isContainer(list[0]))
        && (list.size() < 2 || isContainer(list[1]))
        && (list.size() < 3 || isContainer(list[2]))
        && (list.size() < 4 || isContainer(list[3]))
        && (list.size() < 5 || isContainer(list[4]))
        && (list.size() < 6 || isContainer(list[5]));
    }

    // Each goal is optional (the merged document holds the ones that were ever chosen).
    function isGoals(g) {
      return g is map
        && g.keys().hasOnly(['kcal', 'proteinG', 'carbsNetG', 'fatG', 'waterMl', 'steps'])
        && (!('kcal' in g) || (g.kcal is number && g.kcal >= 800 && g.kcal <= 10000))
        && (!('proteinG' in g) || (g.proteinG is number && g.proteinG >= 0 && g.proteinG <= 500))
        && (!('carbsNetG' in g) || (g.carbsNetG is number && g.carbsNetG >= 0 && g.carbsNetG <= 1000))
        && (!('fatG' in g) || (g.fatG is number && g.fatG >= 0 && g.fatG <= 500))
        && (!('waterMl' in g) || (g.waterMl is number && g.waterMl >= 500 && g.waterMl <= 10000))
        && (!('steps' in g) || (g.steps is number && g.steps >= 0 && g.steps <= 100000));
    }

    // The profile document (spec §4). Every field is optional: the app has a default for each. The merged document is what is checked.
    function isProfile(d) {
      return d.keys().hasOnly(['timezone', 'sex', 'birthYear', 'heightCm', 'activityLevel', 'goalMode', 'weeklyLossKg', 'goals', 'quitDate', 'cigarettesPerDay', 'packSize', 'packPrice', 'waterContainers', 'createdAt', 'ui'])
        && (!('timezone' in d) || isShortText(d.timezone, 64))
        && (!('sex' in d) || d.sex in ['male', 'female'])
        && (!('birthYear' in d) || (d.birthYear is int && d.birthYear >= 1900 && d.birthYear <= 2100))
        && (!('heightCm' in d) || (d.heightCm is number && d.heightCm >= 100 && d.heightCm <= 250))
        && (!('activityLevel' in d) || d.activityLevel in ['sedentary', 'light', 'active'])
        && (!('goalMode' in d) || d.goalMode in ['deficit', 'maintenance', 'surplus'])
        && (!('weeklyLossKg' in d) || (d.weeklyLossKg is number && d.weeklyLossKg >= 0.1 && d.weeklyLossKg <= 2))
        && (!('goals' in d) || isGoals(d.goals))
        && (!('quitDate' in d) || isDayKey(d.quitDate))
        && (!('cigarettesPerDay' in d) || (d.cigarettesPerDay is int && d.cigarettesPerDay >= 0 && d.cigarettesPerDay <= 200))
        && (!('packSize' in d) || (d.packSize is int && d.packSize >= 1 && d.packSize <= 100))
        && (!('packPrice' in d) || (d.packPrice is number && d.packPrice >= 0 && d.packPrice <= 100))
        && (!('waterContainers' in d) || isContainers(d.waterContainers))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('ui' in d) || isUiPrefs(d.ui));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isProfile(request.resource.data);
    }

    match /users/{uid}/waterEntries/{entryId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['day', 'ml', 'createdAt', 'deletedAt'])
        && isDayKey(request.resource.data.day)
        && request.resource.data.ml is number
        && request.resource.data.ml > 0
        && request.resource.data.ml <= 5000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.deletedAt == null;
      // Soft delete only, and only once: the batch moving the day total fails with it.
      allow update: if isOwner(uid)
        && resource.data.deletedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt is timestamp;
    }

    match /users/{uid}/days/{day} {
      allow create, update: if isOwner(uid)
        && isDayKey(day)
        && request.resource.data.keys().hasOnly(['waterMl', 'kcal', 'proteinG', 'carbsG', 'fatG', 'weightKg', 'waistCm', 'steps', 'stepsSource', 'stepsSyncedAt', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && atLeast(request.resource.data, 'waterMl', 0)
        && atLeast(request.resource.data, 'kcal', -0.05)
        && atLeast(request.resource.data, 'proteinG', -0.05)
        && atLeast(request.resource.data, 'carbsG', -0.05)
        && atLeast(request.resource.data, 'fatG', -0.05)
        // The measures of the body: one value a day, typed by hand (spec §4 rule 8).
        && (!('weightKg' in request.resource.data) || (request.resource.data.weightKg is number && request.resource.data.weightKg >= 20 && request.resource.data.weightKg <= 400))
        && (!('waistCm' in request.resource.data) || (request.resource.data.waistCm is number && request.resource.data.waistCm >= 30 && request.resource.data.waistCm <= 300))
        // The steps read from Health Connect by the phone that writes them (spec §7), with their source and the time of the sync.
        && (!('steps' in request.resource.data) || (request.resource.data.steps is number && request.resource.data.steps >= 0 && request.resource.data.steps <= 200000))
        && (!('stepsSource' in request.resource.data) || request.resource.data.stepsSource in ['fitbit', 'phone'])
        && (!('stepsSyncedAt' in request.resource.data) || request.resource.data.stepsSyncedAt is timestamp);
    }

    match /users/{uid}/foodEntries/{entryId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['day', 'meal', 'foodRef', 'foodName', 'grams', 'macros', 'nutrients', 'createdAt', 'updatedAt', 'deletedAt'])
        && isDayKey(request.resource.data.day)
        && request.resource.data.meal in ['breakfast', 'lunch', 'dinner', 'snack']
        && isFoodRef(request.resource.data.foodRef)
        && isShortText(request.resource.data.foodName, 200)
        && isGrams(request.resource.data.grams)
        && isEntryMacros(request.resource.data.macros)
        && (!('nutrients' in request.resource.data) || isEntryNutrients(request.resource.data.nutrients))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.deletedAt == null;
      // Either a soft delete (once: the batch moving the day totals fails with it) or a change of quantity, group or time.
      allow update: if isOwner(uid)
        && resource.data.deletedAt == null
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
            && request.resource.data.deletedAt is timestamp)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day', 'meal', 'createdAt', 'grams', 'macros', 'nutrients', 'updatedAt'])
            && isDayKey(request.resource.data.day)
            && request.resource.data.meal in ['breakfast', 'lunch', 'dinner', 'snack']
            && request.resource.data.createdAt is timestamp
            && isGrams(request.resource.data.grams)
            && isEntryMacros(request.resource.data.macros)
            && (!('nutrients' in request.resource.data) || isEntryNutrients(request.resource.data.nutrients))
            && request.resource.data.updatedAt is timestamp)
        );
    }

    match /users/{uid}/foods/{foodId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'state', 'per100g', 'portions', 'nutrients', 'source', 'brand', 'barcode', 'updatedAt', 'deletedAt'])
        && isFoodFields(request.resource.data)
        && isFoodExtras(request.resource.data)
        && request.resource.data.deletedAt == null;
      allow update: if isOwner(uid)
        && resource.data.deletedAt == null
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
            && request.resource.data.deletedAt is timestamp)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'state', 'per100g', 'portions', 'updatedAt'])
            && isFoodFields(request.resource.data))
        );
    }

    match /users/{uid}/favoriteMeals/{mealId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'items', 'updatedAt'])
        && isShortText(request.resource.data.name, 100)
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(uid);
    }

    // The detailed shape of a programme (phases, sessions, exercises) is checked by the domain: here only the sizes of the lists are bounded.
    match /users/{uid}/plans/{planId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'active', 'startDay', 'phases', 'updatedAt'])
        && isShortText(request.resource.data.name, 100)
        && request.resource.data.active is bool
        && isDayKey(request.resource.data.startDay)
        && request.resource.data.phases is list
        && request.resource.data.phases.size() >= 1
        && request.resource.data.phases.size() <= 12
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(uid);
    }

    // A workout is recorded once, as it was done: no change, no deletion in M3 (spec §4 rule 1).
    match /users/{uid}/workoutLogs/{logId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['day', 'planId', 'sessionName', 'exerciseIds', 'sets', 'durationMin', 'createdAt', 'deletedAt'])
        && isDayKey(request.resource.data.day)
        && isShortText(request.resource.data.planId, 100)
        && isShortText(request.resource.data.sessionName, 100)
        && request.resource.data.exerciseIds is list
        && request.resource.data.exerciseIds.size() >= 1
        && request.resource.data.exerciseIds.size() <= 20
        && request.resource.data.sets is list
        && request.resource.data.sets.size() >= 1
        && request.resource.data.sets.size() <= 400
        && request.resource.data.durationMin is int
        && request.resource.data.durationMin >= 1
        && request.resource.data.durationMin <= 1440
        && request.resource.data.createdAt is timestamp
        && request.resource.data.deletedAt == null;
    }

    // A craving is noted once, as it happens; only a mis-tap takes it back (no total depends on it).
    match /users/{uid}/cravings/{cravingId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['day', 'createdAt', 'resisted'])
        && isDayKey(request.resource.data.day)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.resisted is bool;
      allow delete: if isOwner(uid);
    }

    // The phones of the account: which one writes the steps (spec §4).
    match /users/{uid}/devices/{deviceId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'stepsWriter', 'lastStepsSyncAt'])
        && (!('name' in request.resource.data) || isShortText(request.resource.data.name, 100))
        && (!('stepsWriter' in request.resource.data) || request.resource.data.stepsWriter is bool)
        && (!('lastStepsSyncAt' in request.resource.data) || request.resource.data.lastStepsSyncAt is timestamp);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/milestones/{milestoneId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['metric', 'target', 'direction', 'label'])
        && isShortText(request.resource.data.metric, 120)
        && request.resource.data.target is number
        && request.resource.data.target >= 0
        && request.resource.data.target <= 100000
        && request.resource.data.direction in ['up', 'down']
        && isShortText(request.resource.data.label, 100);
      // Reaching a milestone is the only change, and it happens once.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['achievedAt'])
        && !('achievedAt' in resource.data)
        && request.resource.data.achievedAt is timestamp;
      allow delete: if isOwner(uid);
    }
  }
}
