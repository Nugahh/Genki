{
  "name": "genki",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-firebase/app": "27.0.0",
    "@react-native-firebase/auth": "27.0.0",
    "@react-native-firebase/firestore": "27.0.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "firebase": "13.0.0",
    "firebase-tools": "^15.34.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint src app scripts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest",
    "build:ciqual": "NODE_NO_WARNINGS=1 node scripts/build-ciqual.ts",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-genki \"jest -c jest.emulator.config.js\""
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.emulator\\.test\\.ts$"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "private": true
}
